# Configuración de Entorno SinNotario.cl

# Entorno de ejecución
APP_ENV=production
APP_DEBUG=false
APP_URL=https://sinnotario.cl

# Base de datos (SQLite)
DB_PATH=/var/data/sinnotario.sqlite

# Cloudflare R2 Vault (Custodia documental cifrada)
CLOUDFLARE_ACCOUNT_ID=cf9641882a84e35bbf80ae7681d7ee71
CLOUDFLARE_R2_BUCKET=sinnotario-vault-prod
CLOUDFLARE_API_TOKEN=cfat_tu_token_aqui
CLOUDFLARE_R2_ACCESS_KEY_ID=tu_access_key_aqui
CLOUDFLARE_R2_SECRET_ACCESS_KEY=tu_secret_access_key_aqui

# WhatsApp Gateway (Evolution API)
EVOLUTION_API_URL=http://5.183.9.148:8080
EVOLUTION_API_KEY=tu_global_key_aqui

# Pasarelas de Pago
TRANSBANK_ENV=production
TRANSBANK_COMMERCE_CODE=
TRANSBANK_API_KEY=
FLOW_API_KEY=
FLOW_SECRET_KEY=

# Prestador de Servicios de Certificación (Firma Electrónica Avanzada)
PSC_PROVIDER=IDOK
PSC_API_URL=https://api.idok.cl/v1
PSC_API_TOKEN=
