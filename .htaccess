# SinNotario.cl - Reglas de Seguridad y Blindaje Web (LiteSpeed / Apache)

# 0. Redirecciones 301 de URLs antiguas indexadas en Google (Sitio WordPress legado)
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    RewriteRule ^ingreso-clientes/?$ /login.php [R=301,L,NC]
    RewriteRule ^mi-cuenta/?$ /mi-cuenta.php [R=301,L,NC]
    RewriteRule ^carrito/?$ / [R=301,L,NC]
    RewriteRule ^servicios/?$ /#tramites [R=301,L,NC]
    RewriteRule ^preguntas-frecuentes/?$ /#faq [R=301,L,NC]
</IfModule>

# 1. BLOQUEO CRÍTICO: Denegar acceso HTTP directo a toda base de datos SQLite y archivos de entorno
<Files ~ "\.(sqlite|sqlite3|db|env|log|bak|tar|gz|zip|sql)$">
    Require all denied
    Order allow,deny
    Deny from all
</Files>

# 2. Denegar acceso a carpetas sensibles del sistema
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Proteger carpetas internas de backend y base de datos
    RewriteRule ^database/ - [F,L]
    RewriteRule ^config/ - [F,L]
    RewriteRule ^src/ - [F,L]
    RewriteRule ^templates/ - [F,L]
    RewriteRule ^\.env - [F,L]
    RewriteRule (^|/)\.(?!well-known) - [F,L]
</IfModule>

# 3. Endurecimiento de Cabeceras HTTP
<IfModule mod_headers.c>
    # Ocultar huellas de versión y servidor (Anti-Fingerprinting)
    Header unset X-Powered-By
    Header always unset X-Powered-By
    Header unset Server
    Header always unset Server
    Header unset platform
    Header always unset platform
    Header unset panel
    Header always unset panel

    # Remover cabecera obsoleta
    Header unset X-XSS-Protection
    Header always unset X-XSS-Protection

    # Cabeceras de transporte y aislamiento
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # Restricción de hardware y APIs sensibles del navegador
    Header always set Permissions-Policy "geolocation=(), camera=(), microphone=(), payment=(), usb=(), accelerometer=(), gyroscope=(), magnetometer=(), display-capture=()"

    # Content Security Policy (CSP) robusta adaptada a SinNotario (FontAwesome CDN, Google Sign-In, Tailwind CDN en mantención)
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://accounts.google.com https://cdnjs.cloudflare.com https://cdn.tailwindcss.com; style-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com https://fonts.googleapis.com https://cdn.tailwindcss.com; font-src 'self' https://cdnjs.cloudflare.com https://fonts.gstatic.com data:; img-src 'self' data: https:; connect-src 'self' https://accounts.google.com; frame-src 'self' https://accounts.google.com; frame-ancestors 'self'; base-uri 'self'; form-action 'self' https://accounts.google.com; upgrade-insecure-requests;"
</IfModule>
