{
  "Keystone Dev PHP": {
    "prefix": ["@dev-php", "@php"],
    "body": [
      "@dev-php: ${1:implementa la lógica/endpoint para ...}"
    ],
    "description": "Invocar al especialista backend PHP"
  },
  "Keystone QA Code Review": {
    "prefix": ["@qa", "@qa-code-reviewer"],
    "body": [
      "@qa-code-reviewer: revisa los cambios recientes y verifica php -l y buenas prácticas"
    ],
    "description": "Auditoría de código pre-commit"
  },
  "Keystone Correlativo": {
    "prefix": ["@correlative", "@sol"],
    "body": [
      "@correlative-guardian: reserva el siguiente correlativo SOL para ${1:descripción de la tarea}"
    ],
    "description": "Asignar correlativo atómico en CONTROL_CORRELATIVOS.md"
  },
  "Keystone SecOps": {
    "prefix": ["@secops", "@seguridad"],
    "body": [
      "@secops-guardian: audita la seguridad, sanitización de inputs y blindaje contra OWASP"
    ],
    "description": "Auditoría de seguridad y 2FA"
  },
  "Keystone Smoke Test": {
    "prefix": ["@smoke", "@qa-smoke-tester"],
    "body": [
      "@qa-smoke-tester: ejecuta smoke test HTTP 200 en ${1:https://qa.sinnotario.cl}"
    ],
    "description": "Validación post-despliegue"
  }
}
